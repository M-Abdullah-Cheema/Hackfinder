DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
# Optional Gemini fallback: set AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
PROXY_API_KEY=your_scraperapi_key_here
SCRAPY_CONCURRENCY=16
SCRAPE_INTERVAL_SECONDS=21600
# Calendar / API feeds (comma-separated). Leave blank to skip.
# EVENTBRITE_API_TOKEN=
# EVENTBRITE_ORG_IDS=
# MEETUP_API_TOKEN=
# MEETUP_GROUP_URLNAMES=
# LUMA_API_KEY=
# LUMA_CALENDAR_IDS=
# RSS_FEED_URLS=
# ICAL_FEED_URLS=
