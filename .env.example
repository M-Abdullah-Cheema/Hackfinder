DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
REDIS_URL=redis://localhost:6379/0

# --- AI extraction ---
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# Prefer 70B for cleaner titles; fall back to llama-3.1-8b-instant if rate-limited
GROQ_MODEL=llama-3.3-70b-versatile
# Optional Gemini extraction: set AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Embeddings (dedup) ---
# auto = Gemini when a billed AI Studio key is set, else FastEmbed
# gemini = force Gemini (requires non-AQ. GEMINI_API_KEY + billing)
# fastembed = local only
EMBEDDING_PROVIDER=auto

# --- Proxy (Scrapy always; Playwright when key/server is set) ---
# ScraperAPI: https://www.scraperapi.com/
PROXY_API_KEY=
# Or residential:
# PROXY_SERVER=http://host:port
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_COUNTRY=us
# USE_PLAYWRIGHT_PROXY=auto   # auto|1|0 — auto uses proxy when configured

SCRAPY_CONCURRENCY=16
SCRAPE_INTERVAL_SECONDS=21600

# --- Geocoding (map pins from city/country) ---
GEOCODER_ENABLED=1
NOMINATIM_USER_AGENT=HackFinder/1.0 (local-dev)

# --- Calendar / API feeds (leave blank to skip) ---
# Eventbrite: https://www.eventbrite.com/platform/api-keys/
# EVENTBRITE_API_TOKEN=
# EVENTBRITE_ORG_IDS=org_id_1,org_id_2
# Meetup GraphQL: https://www.meetup.com/api/oauth/list/
# MEETUP_API_TOKEN=
# MEETUP_GROUP_URLNAMES=group-urlname-1,group-urlname-2
# Luma: calendar IDs from luma.com; optional API key
# LUMA_API_KEY=
# LUMA_CALENDAR_IDS=cal_xxx,cal_yyy
# Free public feeds (no key):
# RSS_FEED_URLS=
# ICAL_FEED_URLS=
